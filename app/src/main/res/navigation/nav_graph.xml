<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.moviflix.ui.home.HomeFragment"
        android:label="الرئيسية">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/detailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.moviflix.ui.search.SearchFragment"
        android:label="البحث">
        <action
            android:id="@+id/action_search_to_detail"
            app:destination="@id/detailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/downloadsFragment"
        android:name="com.moviflix.ui.downloads.DownloadsFragment"
        android:label="التنزيلات" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.moviflix.ui.settings.SettingsFragment"
        android:label="الإعدادات" />

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.moviflix.ui.detail.DetailFragment"
        android:label="التفاصيل">
        <argument
            android:name="contentId"
            app:argType="string" />
        <argument
            android:name="category"
            app:argType="integer"
            android:defaultValue="1" />
        <argument
            android:name="title"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="cover"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

</navigation>
